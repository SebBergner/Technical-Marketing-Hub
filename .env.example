# Copy to .env for local development. .env is gitignored — never commit real values.

# ---------------------------------------------------------------- storage
# Omit entirely to use the local SQLite default.
# Azure SQL example (needs ODBC Driver 18 + pyodbc):
# DATABASE_URL=mssql+pyodbc://<user>:<pass>@<server>.database.windows.net/<db>?driver=ODBC+Driver+18+for+SQL+Server
# SQL_ECHO=false

# ------------------------------------------------------------ Microsoft Graph
# From the Entra ID app registration: application permission Sites.Selected,
# PLUS a site-level grant. Both steps are required — step 1 alone grants
# nothing, and the symptom is a valid token with 403 on every call.
#
# Run this FIRST when the credentials arrive; it tells bad credentials apart
# from a missing site grant:
#     python scripts/check_graph.py
#
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# Note the host is ptccloud, not ptc.
# GRAPH_SITE_URL=https://ptccloud.sharepoint.com/sites/EXT-TDD
# GRAPH_LIST_NAME=Demo Catalog

# ---------------------------------------------------------------- Consensus
# Auth is a BODY object on every call, not a header — the OpenAPI spec declares
# no securitySchemes and every path uses `security: []`. All four of key,
# secret, user_email and base_url must be set or the client stays on the stub.
#
# Run GET /api/consensus/probe first: it calls info/userInfo (the cheapest
# authenticated call) and prints the live field names beside our mapping.
# NEVER put real values in this file — it is committed to git. Real values go
# in .env, which is gitignored.
# CONSENSUS_BASE_URL=https://app.goconsensus.com
# CONSENSUS_API_KEY=
# CONSENSUS_API_SECRET=
# CONSENSUS_USER_EMAIL=
# CONSENSUS_SOURCE_NAME=TDD Portal
# Sends return only a hash, never a full URL, so the viewer host is config.
# CONSENSUS_VIEWER_URL_TEMPLATE=https://play.goconsensus.com/{hash}?preview=sales
#
# Two ways into V2, and which one an environment uses is deliberate.
#
# OAuth is the real one and it WORKS as of 2026-09-15 — the weeks it appeared
# broken were our own unconditional `platform` header, not Consensus (see the
# docstring in backend/integrations/consensus_v2.py). It refreshes itself, so
# once authorised an environment needs no further attention.
#
# get_v2_client() prefers OAuth and falls back to CONSENSUS_V2_TOKEN, so an
# environment picks its path simply by what it has.
#
#   local       OAuth. Authorise once at /api/consensus/oauth/start.
#   Azure slots CONSENSUS_V2_TOKEN, because /api/consensus/oauth/start needs
#               the curator role and AUTH_CURATOR_GROUPS cannot be filled in
#               until SSO exists — nobody on Azure can complete the browser
#               flow. Decided with Liwei 2026-09-22.
#
# They must NOT share one OAuth grant. Refresh tokens rotate: every refresh
# may invalidate the previous one, so two environments refreshing the same
# grant take turns breaking each other. Separate paths avoid that entirely.
#
# CONSENSUS_OAUTH_CLIENT_ID=
# CONSENSUS_OAUTH_CLIENT_SECRET=
#
# The hand-obtained fallback. Short-lived and tied to a person: copy the
# `Authorization: Bearer …` value from any request the interactive docs portal
# makes (https://app.goconsensus.com/api/v2/docs/portal/, DevTools → Network).
#
# When it expires, a Consensus sync refuses with "This mirror was built from
# Consensus V2 and a V1 sync would replace it…" — that guard is doing its job,
# not reporting a fault. Nothing is lost while it is dead: the mirror keeps
# serving, only re-syncing stops. Paste a fresh token into both Azure slots.
# CONSENSUS_V2_TOKEN=

# ---------------------------------------------------------------- Brightcove
# BRIGHTCOVE_ACCOUNT_ID=
# BRIGHTCOVE_CLIENT_ID=
# BRIGHTCOVE_CLIENT_SECRET=

# --------------------------------------------------------------------- auth
# "disabled" (default) IGNORES the Easy Auth headers rather than trusting them,
# so a forged header cannot grant access on a machine where auth was never set
# up. Local runs get a clearly-labelled dev principal with full rights.
#
# "easyauth" trusts the platform headers, and is ONLY correct behind App Service
# Authentication with "Require authentication" enabled. Setting it anywhere else
# is an auth bypass.
#
# "oidc" is the app signing people in itself -- /login, /auth/callback and
# /logout, with every other route closed until you have. The mode the Hub
# moves to once IT has created the app registration (callbacks given to IT
# 2026-09-23: https://tmh.ptcxc.com/auth/callback and the dev-tmh one). Needs
# the OIDC_* and session settings below. See docs/deploying.md.
# AUTH_MODE=oidc
#
# Curators by Entra object id -- the `oid` claim, shown as "object_id" by
# GET /api/auth/me once you are signed in. The strongest per-person key: an
# oid never changes and is never reused, where an address can do both.
# AUTH_CURATOR_OIDS=00000000-0000-0000-0000-000000000000
#
# Curators named by address, comma separated. Matched case-insensitively
# against the address the identity provider asserts -- never one a caller
# supplies, because headers are ignored entirely unless AUTH_MODE=easyauth.
#
# Use this when the curator list is a few people known by name: it needs
# NOTHING from the identity provider beyond the address it already sends, so
# no group claim has to be requested, emitted, or kept in step with a
# directory. Liwei, Elio and Seb, 2026-09-22.
#
# The trade-off: an address is a weaker key than a group. It changes when
# somebody's name changes, it is not revoked when they leave, and keeping it
# current is a person's job rather than the directory's. Right for three
# names; move to AUTH_CURATOR_GROUPS or an app role before it is a dozen.
# AUTH_CURATOR_EMAILS=first.last@ptc.com,other.person@ptc.com
#
# Entra ID group object id(s) whose members may curate — decide metadata
# proposals, trigger a sync, and later write to SharePoint. Comma-separated.
# Empty means nobody can curate, which fails closed. An app role literally
# named "curator" also works, if you prefer app roles to groups.
# AUTH_CURATOR_GROUPS=00000000-0000-0000-0000-000000000000
#
# Check it landed:  GET /api/auth/me   (the "warnings" field is the one to read)

# ----------------------------------------------- sign-in (AUTH_MODE=oidc only)
# The Entra app registration IT creates for interactive sign-in. Separate from
# GRAPH_*, which reads SharePoint as the app: one proves who a person is, the
# other acts as the app, and neither should be widened while touching the
# other. Delegated scopes are openid, profile and email -- no Graph access as
# the user is needed.
# OIDC_TENANT_ID=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
#
# Must match a redirect URI registered on the app registration, exactly.
# Leave blank locally (derived: http://localhost:8000/auth/callback, which IT
# has to register too if local sign-in is wanted). On Azure it MUST be set,
# and as a DEPLOYMENT SLOT SETTING -- it differs per slot, and a swap would
# otherwise hand each slot the other's address.
# OIDC_REDIRECT_URI=https://tmh.ptcxc.com/auth/callback
#
# The next five share AMP's names, so the two apps' Azure settings can be
# compared line by line.
#
# Signs the session cookie. Long and random; one per slot, as a slot setting.
# Unset means a random key per process -- nothing forgeable, but every restart
# signs everyone out.
# SECRET_KEY=
#
# true on Azure (Secure cookie); leave false locally, where a Secure cookie
# over plain http is never stored and sign-in would loop.
# HTTPS_ONLY=true
#
# Idle timeout in hours, sliding. And the hard ceiling however active the
# session is, so someone disabled in Entra loses access within a day.
# SESSION_TIMEOUT_HOURS=12
# SESSION_ABSOLUTE_HOURS=24
#
# The canonical hostname. When set, *.azurewebsites.net redirects to it,
# keeping path and query -- which is what makes the invitation email's
# azurewebsites.net link still work once sign-in only returns to the custom
# domain. A slot setting (tmh vs dev-tmh), and only to be set once the domain
# actually answers, or it points everyone at nothing.
# CUSTOM_DOMAIN=tmh.ptcxc.com

# ------------------------------------------------ the admin bridge (temporary)
# One shared username/password for the Admin page (/admin), covering the
# stretch before Entra SSO exists. Both blank by default: while either is
# empty there is no admin at all and every admin route answers 503, so a
# half-configured deployment cannot accidentally expose the page.
#
# One credential for everybody means nothing done through it can be attributed
# to a person. That is deliberate, and it is why an admin session unlocks only
# our own data and the mirror refresh -- never a SharePoint write-back. See
# backend/admin_auth.py. There is no lockout either (with a single account it
# would be a denial of service anyone could trigger), so the password has to
# be long enough that guessing is hopeless. Nothing in the code can enforce
# that; it is on whoever sets it.
#
# Delete both, and backend/admin_auth.py, when SSO lands.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# ---------------------------------------------------------------- behaviour
# Keep the mockup's aspirational sidebar numbers (86/22/9/14) instead of the
# real counts. Useful for a stakeholder demo; off by default because honest
# numbers are the house rule.
# SHOW_PLACEHOLDER_COUNTS=false
